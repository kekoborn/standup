{
  "name": "@kek/standup",
  "version": "0.1.0",
  "description": "A small CLI that turns recent git history into a markdown standup digest.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "standup": "dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "standup",
    "git",
    "cli",
    "digest",
    "async",
    "changelog",
    "git-log",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kekoborn/standup.git"
  },
  "bugs": {
    "url": "https://github.com/kekoborn/standup/issues"
  },
  "homepage": "https://github.com/kekoborn/standup#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node dist/bin.js",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  }
}
